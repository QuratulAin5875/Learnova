# Learnova Frontend Environment Variables
# Copy this file to .env.local and fill in your public Supabase & FastAPI URLs.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY in the frontend!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_API_URL=http://localhost:8000/api/v1
